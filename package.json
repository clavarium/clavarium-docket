{
  "name": "clavarium-docket",
  "version": "0.1.1",
  "description": "Clavarium Docket: events an AI agent or a script sees and acknowledges, and reminders it sets itself (a command and an MCP server, and a library for the application). No dependency.",
  "license": "MIT",
  "homepage": "https://github.com/clavarium/clavarium-docket#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clavarium/clavarium-docket.git"
  },
  "type": "module",
  "bin": {
    "docket": "bin/docket.mjs",
    "docket-mcp": "server/docket.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "host/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {},
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "npm run check:hooks && npm run check:shapes && npm run check:names && npm run check:shell && npm test",
    "check:shapes": "node tools/check-shapes.mjs",
    "check:names": "node tools/check-ai-names.mjs",
    "check:shell": "node tools/check-shell.mjs",
    "check:hooks": "node tools/check-hooks.mjs",
    "hooks": "git config core.hooksPath hooks",
    "test": "node --test \"test/*.test.mjs\""
  },
  "exports": {
    "./host": "./host/docket-host.mjs",
    "./server": "./server/docket.mjs",
    "./time": "./server/time.mjs"
  }
}
